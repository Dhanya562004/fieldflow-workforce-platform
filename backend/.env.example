# FieldFlow Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Local development default:
DATABASE_URL="postgresql://postgres@localhost:5433/fieldflow?schema=public"

# Production example:
# DATABASE_URL="postgresql://fieldflow_user:securepassword@db.provider.internal:5432/fieldflow_prod?sslmode=require"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Google Gemini AI (Optional - platform falls back gracefully to deterministic rule engine)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760
